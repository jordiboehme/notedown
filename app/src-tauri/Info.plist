<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A menu bar app: no Dock icon at launch. A library or settings window turns it on. -->
	<key>LSUIElement</key>
	<true/>
	<!-- macOS asks once before Notedown reads these folders; these texts say why. -->
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Notedown saves the files you download from your library in the Downloads folder.</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>Notedown reads the files you drop on the library window to upload them.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Notedown reads the files you drop on the library window to upload them.</string>
</dict>
</plist>
