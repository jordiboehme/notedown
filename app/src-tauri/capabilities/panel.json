{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "panel",
  "description": "The panel fits its window to its content, reads the status and opens the other windows or quits.",
  "windows": ["panel"],
  "permissions": [
    "core:window:allow-set-size",
    "allow-get-status",
    "allow-open-library",
    "allow-open-settings",
    "allow-request-quit",
    "allow-quit-app"
  ]
}
